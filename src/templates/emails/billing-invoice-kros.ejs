<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Platobný doklad</title>
</head>
<body style="margin: 0; padding: 0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 16px; line-height: 1.6; color: #0f172a; background-color: #f8fafc;">
  <div style="max-width: 600px; margin: 0 auto; padding: 24px;">
    <h1 style="margin: 0 0 24px; font-size: 1.5rem; font-weight: 600;">Platobný doklad</h1>

    <p style="margin: 0 0 16px;">Ahoj,</p>
    <% if (typeof hasPdfAttachment !== 'undefined' && hasPdfAttachment) { %>
    <p style="margin: 0 0 24px;">
      Ďakujeme za platbu. Faktúru nájdeš v prílohe<% if (displayNumber) { %> — predbežný platobný doklad <strong><%= displayNumber %></strong><% } %>.
    </p>
    <p style="margin: 0 0 24px; color: #64748b; font-size: 0.8125rem; line-height: 1.5;">
      Môžeš si ju stiahnuť aj online: <a href="<%= krosDownloadUrlAttr %>" style="color: #2563eb; word-break: break-all;"><%= krosDownloadUrlText %></a>
    </p>
    <% } else { %>
    <p style="margin: 0 0 24px;">
      Ďakujeme za platbu. Faktúru nájdeš tu<% if (displayNumber) { %> — predbežný platobný doklad <strong><%= displayNumber %></strong><% } %>:
    </p>
    <p style="margin: 0 0 20px;">
      <a href="<%= krosDownloadUrlAttr %>" style="display: inline-block; padding: 12px 20px; background: #0f172a; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600;">Stiahnuť faktúru</a>
    </p>
    <p style="margin: 0 0 24px; word-break: break-all; font-size: 0.9rem;">
      <a href="<%= krosDownloadUrlAttr %>" style="color: #2563eb;"><%= krosDownloadUrlText %></a>
    </p>
    <% } %>

    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin-bottom: 24px;">
      <p style="margin: 0 0 8px; font-weight: 600;">Suma</p>
      <p style="margin: 0; color: #334155;"><%= amountFormatted %></p>
    </div>

    <p style="margin: 0 0 16px; color: #64748b; font-size: 0.9rem;">Účtovné znenie môže ešte upraviť účtovník — tento e-mail je z technického systému.</p>
    <p style="margin: 0 0 24px; color: #64748b; font-size: 0.875rem;">Ak máš otázky, odpovedz na tento e-mail.</p>

    <p style="margin: 0; color: #64748b; font-size: 0.875rem;">S pozdravom,<br>Michal Mihálik</p>
  </div>
</body>
</html>
