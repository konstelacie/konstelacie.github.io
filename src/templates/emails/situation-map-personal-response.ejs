<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= subject %></title>
</head>
<body style="margin: 0; padding: 0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 16px; line-height: 1.6; color: #0f172a; background-color: #f8fafc;">
  <div style="max-width: 600px; margin: 0 auto; padding: 24px;">
    <p style="margin: 0 0 16px;"><%= greeting %></p>
    <% if (intro) { %>
    <p style="margin: 0 0 24px;"><%= intro %></p>
    <% } %>

    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin-bottom: 24px;">
      <%- bodyHtml %>
    </div>

    <p style="margin: 0 0 24px;"><%= signoff %></p>
    <% if (footerNote) { %>
    <p style="margin: 0; color: #64748b; font-size: 0.875rem;"><%= footerNote %></p>
    <% } %>
  </div>
</body>
</html>
