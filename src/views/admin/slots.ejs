<div class="admin-wrap admin-wrap--wide">
  <header class="admin-header admin-header--bar">
    <h1 class="admin-title">Termíny</h1>
    <form method="post" action="/admin/logout">
      <button type="submit" class="admin-btn admin-btn--ghost">Odhlásiť sa</button>
    </form>
  </header>

  <% if (typeof flash !== 'undefined' && flash) { %>
    <p class="admin-flash admin-flash--<%= flash.level %>" role="status"><%= flash.message %></p>
  <% } %>

  <% if (typeof loadError !== 'undefined' && loadError) { %>
    <p class="admin-error" role="alert">Nepodarilo sa načítať termíny. Skúste znova neskôr.</p>
  <% } %>

  <% if (typeof dbConfigured !== 'undefined' && !dbConfigured) { %>
    <p class="admin-error" role="alert">Databáza nie je nakonfigurovaná — zobrazenie termínov nie je k dispozícii.</p>
  <% } %>

  <% if (typeof dbConfigured !== 'undefined' && dbConfigured) { %>
  <nav class="admin-toolbar" aria-label="Obdobie a zobrazenie">
    <div class="admin-toolbar__nav">
      <a class="admin-btn admin-btn--ghost" href="/admin/slots<%= queryPrev %>">← Predchádzajúce</a>
      <span class="admin-toolbar__range"><%= rangeLabel %></span>
      <a class="admin-btn admin-btn--ghost" href="/admin/slots<%= queryNext %>">Ďalšie →</a>
    </div>
    <div class="admin-toolbar__toggle" role="group" aria-label="Rozsah kalendára">
      <a class="admin-btn <%= view === 'day' ? 'admin-btn--primary' : 'admin-btn--ghost' %>" href="/admin/slots<%= queryDayToggle %>">Deň</a>
      <a class="admin-btn <%= view === 'week' ? 'admin-btn--primary' : 'admin-btn--ghost' %>" href="/admin/slots<%= queryWeekToggle %>">Týždeň</a>
    </div>
  </nav>

  <% if (typeof days !== 'undefined' && days.length) { %>
    <% for (const day of days) { %>
      <section class="admin-day" aria-labelledby="day-<%= day.date %>">
        <h2 id="day-<%= day.date %>" class="admin-day__title"><%= day.heading %></h2>
        <% if (!day.slots.length) { %>
          <p class="admin-day__empty">Žiadne termíny.</p>
        <% } else { %>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th scope="col">Čas</th>
                  <th scope="col">Stav</th>
                  <th scope="col">E-mail</th>
                  <th scope="col">Akcie</th>
                </tr>
              </thead>
              <tbody>
                <% for (const slot of day.slots) { %>
                  <tr>
                    <td><%= slot.timeKey %></td>
                    <td><span class="admin-status admin-status--<%= slot.statusKey %>"><%= slot.statusLabel %></span></td>
                    <td class="admin-table__email"><%= slot.email ? slot.email : '—' %></td>
                    <td class="admin-table__actions">
                      <% if (slot.actions.block || slot.actions.unblock || slot.actions.cancel) { %>
                        <div class="admin-actions">
                          <% if (slot.actions.block) { %>
                            <form method="post" action="/admin/slots/<%= slot.id %>/block" class="admin-inline-form">
                              <input type="hidden" name="view" value="<%= view %>">
                              <input type="hidden" name="date" value="<%= anchorDate %>">
                              <button type="submit" class="admin-btn admin-btn--ghost admin-btn--small">Zablokovať</button>
                            </form>
                          <% } %>
                          <% if (slot.actions.unblock) { %>
                            <form method="post" action="/admin/slots/<%= slot.id %>/unblock" class="admin-inline-form">
                              <input type="hidden" name="view" value="<%= view %>">
                              <input type="hidden" name="date" value="<%= anchorDate %>">
                              <button type="submit" class="admin-btn admin-btn--ghost admin-btn--small">Odblokovať</button>
                            </form>
                          <% } %>
                          <% if (slot.actions.cancel) { %>
                            <form method="post" action="/admin/slots/<%= slot.id %>/cancel" class="admin-inline-form" onsubmit="return confirm('Zrušiť tento termín?');">
                              <input type="hidden" name="view" value="<%= view %>">
                              <input type="hidden" name="date" value="<%= anchorDate %>">
                              <button type="submit" class="admin-btn admin-btn--ghost admin-btn--small">Zrušiť</button>
                            </form>
                          <% } %>
                        </div>
                      <% } else { %>
                        —
                      <% } %>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>
  <% } %>
  <% } %>
</div>
