<main>
  <div class="container home-prelaunch">
    <p>Stránka sa pripravuje.</p>
    <% if (typeof funnelCampaignLinks !== 'undefined' && funnelCampaignLinks.length) { %>
      <ul class="muted home-prelaunch__campaign-list">
        <% funnelCampaignLinks.forEach(function (row) { %>
          <li>
            <a href="<%= row.href %>"><%= row.funnelName %> — <%= row.campaignId %></a>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</main>
