<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title : 'Administrácia' %></title>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="admin-body">
  <% if (typeof adminSection !== 'undefined') { %>
  <nav class="admin-nav" aria-label="Hlavná sekcia administrácie">
    <a class="admin-nav__link <%= adminSection === 'slots' ? 'admin-nav__link--active' : '' %>" href="/admin/slots">Termíny</a>
    <a class="admin-nav__link <%= adminSection === 'reservations' ? 'admin-nav__link--active' : '' %>" href="/admin/reservations">Rezervácie</a>
    <a class="admin-nav__link <%= adminSection === 'billing' ? 'admin-nav__link--active' : '' %>" href="/admin/billing">Platobné doklady</a>
  </nav>
  <% } %>
  <%- body %>
</body>
</html>
