<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title : 'Administrácia' %></title>
  <%- include('../partials/favicon') %>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="admin-body">
  <% if (typeof openCriticalAlertCount !== 'undefined' && openCriticalAlertCount > 0) { %>
  <div class="admin-critical-banner" role="alert">
    <p class="admin-critical-banner__title">🔴 Kritické systémové problémy</p>
    <p class="admin-critical-banner__text">
      <%= openCriticalAlertCount === 1 ? '1 nevyriešené kritické upozornenie vyžaduje pozornosť.' : openCriticalAlertCount + ' nevyriešených kritických upozornení vyžaduje pozornosť.' %>
    </p>
    <a class="admin-critical-banner__link" href="/admin/alerts">Zobraziť upozornenia</a>
  </div>
  <% } %>
  <% if (typeof adminSection !== 'undefined') { %>
  <nav class="admin-nav" aria-label="Hlavná sekcia administrácie">
    <a class="admin-nav__link <%= adminSection === 'slots' ? 'admin-nav__link--active' : '' %>" href="/admin/slots">Termíny</a>
    <a class="admin-nav__link <%= adminSection === 'reservations' ? 'admin-nav__link--active' : '' %>" href="/admin/reservations">Rezervácie</a>
    <a class="admin-nav__link <%= adminSection === 'billing' ? 'admin-nav__link--active' : '' %>" href="/admin/billing">Platobné doklady</a>
    <a class="admin-nav__link <%= adminSection === 'alerts' ? 'admin-nav__link--active' : '' %>" href="/admin/alerts">Upozornenia</a>
    <a class="admin-nav__link <%= adminSection === 'maintenance' ? 'admin-nav__link--active' : '' %>" href="/admin/maintenance">Údržba</a>
  </nav>
  <% } %>
  <%- body %>
</body>
</html>
