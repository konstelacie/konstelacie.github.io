<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'citimtedasom.sk' %>">
  <% if (typeof robotsNoindex !== 'undefined' && robotsNoindex) { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>
  <title><%= typeof title !== 'undefined' ? title : 'citimtedasom.sk' %></title>
  <link rel="stylesheet" href="/assets/css/site.css">
  <%- typeof extraStyles !== 'undefined' && extraStyles ? extraStyles : '' %>
</head>
<body>
  <% if (typeof showTestingBanner !== 'undefined' && showTestingBanner) { %>
  <div class="site-testing-banner" role="status" aria-live="polite">
    Pozor: Stránka je momentálne v testovacej prevádzke. Prosíme, nepoužívajte ju ako bežný návštevník.
  </div>
  <% } %>
  <% if (typeof hideHeader === 'undefined' || !hideHeader) { %>
  <%- include('../partials/header') %>
  <% } %>
  <%- body %>
  <%- include('../partials/footer') %>
  <% if (typeof metaPixelId !== 'undefined' && metaPixelId) { %>
  <%- include('../partials/cookie-banner') %>
  <script src="/assets/js/cookie-consent.js" defer></script>
  <% } %>
  <%- typeof extraScripts !== 'undefined' && extraScripts ? extraScripts : '' %>
</body>
</html>
