<!-- Shared booking and long-form content block used by home/funnel pages. -->
<% var _useLegacyFunnelClasses = typeof useLegacyFunnelClasses === 'undefined' ? true : !!useLegacyFunnelClasses; %>
<% var _renderSecondaryContent = typeof renderSecondaryContent === 'undefined' ? true : !!renderSecondaryContent; %>
<% var _minSessionEur = minSessionTotalEur; %>
<% var _fullCheckoutEur = fullPaymentCheckoutEur; %>
<% var _depositEur = typeof reservationDepositEur !== 'undefined' ? reservationDepositEur : _minSessionEur; %>
<section id="booking" class="content-cta<% if (_useLegacyFunnelClasses) { %> funnel-cta<% } %> booking-section prose"
  <% if (typeof funnelName !== 'undefined' && funnelName) { %>data-funnel-name="<%= funnelName %>"<% } %>
  <% if (typeof funnelName !== 'undefined' && funnelName && typeof funnelCampaignId !== 'undefined') { %>data-funnel-campaign="<%= funnelCampaignId %>"<% } %>
  <% if (typeof funnelVideoId !== 'undefined' && funnelVideoId) { %>data-funnel-video-id="<%= funnelVideoId %>"<% } %>
  data-reservation-deposit-eur="<%= _depositEur %>"
  data-full-payment-checkout-eur="<%= _fullCheckoutEur %>"
>
  <div id="booking-main" class="booking-main">
  <div class="container">
    <h2 class="visually-hidden">Vyber si termín</h2>

    <section class="booking-calendar" aria-label="Rezervácia termínu">
      <p id="booking-calendar-loading" class="booking-calendar__loading muted">Načítavam termíny…</p>
      <div id="booking-calendar-inner" class="booking-calendar__inner" hidden>
        <p id="booking-slot-pending" class="booking-calendar__pending muted" hidden aria-live="polite"></p>
        <div id="booking-calendar-hero" class="booking-calendar__hero" hidden>
          <p class="booking-calendar__hero-label">Najbližší voľný termín:</p>
          <div id="booking-hero-slot-host" class="booking-calendar__hero-slot-host" role="group" aria-label="Najbližší voľný termín"></div>
        </div>
        <div id="booking-calendar-days" class="booking-calendar__days"></div>
      </div>
      <p id="booking-slots-empty" class="booking-calendar__empty muted" hidden>
        Momentálne nie sú dostupné žiadne termíny.
      </p>
      <p id="booking-slots-error" class="booking-error booking-calendar__error" hidden></p>
    </section>

    <div id="booking-hold-banner" class="booking-hold-banner" hidden>
      <p id="booking-hold-message"><strong>Termín držíme pre Teba.</strong> Dokonči platbu do 15 minút.</p>
      <p id="booking-countdown" class="booking-countdown" aria-live="polite">15:00</p>
      <button type="button" id="booking-revoke-btn" class="booking-revoke-btn">Uvoľniť termín</button>
    </div>

    <div id="booking-success" class="booking-success" hidden>
      <h3>Rezervácia je vytvorená</h3>
      <p id="booking-success-pending" class="muted">Presmerovávam na platbu…</p>
      <p id="booking-success-failed" class="booking-error" hidden></p>
      <button type="button" id="booking-payment-retry" class="cta" hidden>Skúsiť platbu znova</button>
    </div>
  </div>
  </div>

  <div id="booking-email-modal" class="booking-modal" hidden>
    <div class="booking-modal__backdrop" data-booking-modal-dismiss role="presentation"></div>
    <div
      class="booking-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="booking-modal-title"
    >
      <button type="button" id="booking-modal-close" class="booking-modal__close" aria-label="Zavrieť">×</button>
      <h3 id="booking-modal-title" class="booking-modal__title">Pokračuj v rezervácii termínu</h3>
      <p id="booking-modal-phase" class="booking-modal__phase">
        Pokračuj zadaním e-mailu.
      </p>
      <div id="booking-modal-selected" class="booking-modal__selected" hidden>
        <p id="booking-modal-selected-label" class="booking-modal__selected-label">Tento termín držíme pre Teba:</p>
        <p id="booking-modal-selected-value" class="booking-modal__selected-value" aria-live="polite"></p>
      </div>
      <p id="booking-modal-countdown" class="booking-modal__countdown" aria-live="polite">Termín držíme ešte: 05:00</p>
      <div id="booking-modal-step-email">
        <form id="booking-email-form" class="booking-email-form booking-modal__form">
          <label for="booking-billing-name">Meno a priezvisko *</label>
          <input
            type="text"
            id="booking-billing-name"
            name="billingName"
            required
            placeholder="Meno a priezvisko"
            autocomplete="name"
          >
          <label for="booking-email">E-mail *</label>
          <input type="email" id="booking-email" name="email" required placeholder="vas@email.sk" autocomplete="email">
          <label class="booking-company-toggle">
            <input type="checkbox" id="booking-billing-is-company" name="billingIsCompany">
            <span>Potrebujem doklad pre firmu</span>
          </label>
          <div id="booking-company-fields" class="booking-company-fields" hidden>
            <label for="booking-billing-company-name">Názov firmy *</label>
            <input type="text" id="booking-billing-company-name" name="billingCompanyName" autocomplete="organization">
            <label for="booking-billing-ico">IČO *</label>
            <input type="text" id="booking-billing-ico" name="billingIco" inputmode="numeric" pattern="[0-9]{8}" maxlength="8">
            <label for="booking-billing-dic">DIČ</label>
            <input type="text" id="booking-billing-dic" name="billingDic">
            <label for="booking-billing-ic-dph">IČ DPH</label>
            <input type="text" id="booking-billing-ic-dph" name="billingIcDph">
            <label for="booking-billing-street">Ulica a číslo *</label>
            <input type="text" id="booking-billing-street" name="billingStreet" autocomplete="address-line1">
            <label for="booking-billing-city">Mesto *</label>
            <input type="text" id="booking-billing-city" name="billingCity" autocomplete="address-level2">
            <label for="booking-billing-post-code">PSČ *</label>
            <input type="text" id="booking-billing-post-code" name="billingPostCode" autocomplete="postal-code">
            <label for="booking-billing-country">Krajina</label>
            <select id="booking-billing-country" name="billingCountry">
              <option value="SK" selected>Slovensko</option>
              <option value="CZ">Česko</option>
              <option value="AT">Rakúsko</option>
              <option value="DE">Nemecko</option>
              <option value="PL">Poľsko</option>
              <option value="HU">Maďarsko</option>
            </select>
          </div>
          <p id="booking-email-error" class="booking-error" hidden></p>
          <button type="submit" id="booking-submit-btn" class="cta">Pokračovať k výberu platby</button>
        </form>
      </div>
      <div id="booking-payment-choice" class="booking-payment-choice booking-modal__payment" hidden>
        <form id="booking-payment-form" class="booking-payment-form">
          <p class="booking-modal__phase booking-payment-instruction">Vyber si spôsob platby:</p>
          <fieldset class="booking-payment-options">
            <legend class="visually-hidden">Spôsob platby</legend>
            <label class="booking-payment-option">
              <input type="radio" name="paymentPath" value="deposit" id="payment-deposit">
              <span class="booking-payment-option-content">
                <strong>Rezervovať sedenie</strong>
                <span class="booking-payment-desc booking-payment-desc--stack">
                  <span class="booking-payment-desc-line">Zaplatíš teraz <%= _depositEur %> € za rezerváciu</span>
                  <span class="booking-payment-desc-line">Doplatok podľa dohody po sedení (spolu min. <%= _minSessionEur %> €)</span>
                </span>
                <span class="booking-payment-amount">Rezervovať za <%= _depositEur %> €</span>
              </span>
            </label>
            <label class="booking-payment-option booking-payment-option--full">
              <input type="radio" name="paymentPath" value="full" id="payment-full">
              <span class="booking-payment-option-content">
                <strong>Zaplatiť celú sumu teraz</strong>
                <span class="booking-payment-desc booking-payment-desc--stack">
                  <span class="booking-payment-desc-line">Jedna platba <span class="booking-payment-desc-em"><%= _fullCheckoutEur %> €</span> pred sedením</span>
                </span>
                <span class="booking-payment-amount">Zaplatiť <%= _fullCheckoutEur %> €</span>
              </span>
            </label>
          </fieldset>
          <p id="booking-payment-path-validation" class="booking-payment-path-validation" hidden role="alert">Vyber prosím spôsob platby</p>
          <p id="booking-payment-error" class="booking-error" hidden></p>
          <div class="booking-payment-actions">
            <button type="button" id="booking-payment-back" class="booking-back-btn">Upraviť e-mail</button>
            <button type="submit" id="booking-payment-submit" class="cta">Pokračovať k platbe</button>
          </div>
        </form>
      </div>
      <button type="button" id="booking-modal-revoke" class="booking-modal__revoke">Zrušiť rezerváciu termínu</button>
    </div>
  </div>

  <div id="booking-payment-complete-overlay" class="booking-payment-complete-overlay" hidden aria-hidden="true">
    <div class="booking-payment-complete-overlay__inner" role="status" aria-live="polite">
      <p class="booking-payment-complete-overlay__title">Dokončujeme platbu</p>
      <p class="booking-payment-complete-overlay__hint muted">Potvrdenie ešte spracúvame…</p>
    </div>
  </div>
</section>

<% if (_renderSecondaryContent) { %>
<details class="content-secondary<% if (_useLegacyFunnelClasses) { %> funnel-secondary<% } %>">
  <summary class="content-secondary-trigger<% if (_useLegacyFunnelClasses) { %> funnel-secondary-trigger<% } %> container">Ešte nie som rozhodnutý</summary>
  <div class="content-secondary-inner<% if (_useLegacyFunnelClasses) { %> funnel-secondary-inner<% } %>">
    <section class="content-how<% if (_useLegacyFunnelClasses) { %> funnel-how<% } %> prose">
      <div class="container">
        <h2>Ako prebieha sedenie</h2>
    
        <p>
          Po úvodnom zvítaní sa Ťa spýtam, s čím prichádzaš. 
          Môžeš hovoriť úplne voľne – nie je potrebné sa na nič pripravovať.
        </p>
    
        <p>
          Jemne Ťa budem smerovať viac do hĺbky – možno aj do uhla pohľadu, 
          ktorým si sa na vec zatiaľ nepozeral.
        </p>
        
        <p>
          Počas celého sedenia vnímam Tvoje reakcie a reč tela.
          Nikdy nepredurčujem smer, naopak, hľadáme ho spolu.
        </p>

        <p>
          Kľúčové pre mňa je nacítiť situáciu – to, čo práve prežívaš. 
          Často sú to pocity alebo emócie, ktoré doteraz nemali toľko priestoru, koľko by potrebovali.
        </p>
        
        <p>
          Na sedení nerobíme životnú zmenu priamo. 
          Skôr uvoľníme to, čo je zaseknuté – a zmena v živote často prichádza sama.
          Prejaví sa v najbližších dňoch, prípadne týždňoch.
        </p>

        <p>
          Ak to dáva zmysel, môžeme ísť aj hlbšie – napríklad cez prácu 
          s rodinnými a vzťahovými vzorcami (metóda konštelácií).
        </p>
      </div>
    </section>

    <section class="content-practical<% if (_useLegacyFunnelClasses) { %> funnel-practical<% } %> prose">
      <div class="container">
        <h2>Formát a technické detaily</h2>
        <p>
          Sedenie trvá približne okolo <strong>jednej hodiny</strong>.
          Prebieha <strong>online cez Google Meet</strong> –
          stačí kliknúť na link, ktorý Ti pošlem pred začiatkom; nič netreba inštalovať.
        </p>
      </div>
    </section>

    <section class="content-audience<% if (_useLegacyFunnelClasses) { %> funnel-audience<% } %> prose">
      <div class="container">
        <h2>Pre koho to je / nie je</h2>
        <p><strong>Hodí sa to najmä Tebe, ak:</strong></p>
        <ul>
          <li>máš opakujúce sa vzorce vo vzťahoch alebo v rodine a chceš im lepšie rozumieť;</li>
          <li>cítiš zaseknutie, úzkosť alebo ťarchu bez jasnej príčiny a chceš priestor, kde Ťa vypočujú bez hodnotenia;</li>
          <li>zaujíma Ťa hlbšia práca a prípadne aj prístup cez konštelácie – bez tlaku, že „sa musí“ stať hneď všetko.</li>
        </ul>
        <p><strong>Nie je to vhodná voľba, ak:</strong></p>
        <ul>
          <li>si v <strong>akútnej kríze</strong> (ohrozenie života, seba alebo iných) – v takom prípade prosím kontaktuj tiesňové služby alebo odborníka, ktorý s krízou pracuje denne;</li>
          <li>očakávaš garantovanú zmenu za jedenkrát alebo jednoduché recepty bez Tvojej účasti v procese;</li>
          <li>online formát pre Teba nie je bezpečný alebo ho nechceš – potom je lepšie hľadať iný typ podpory.</li>
        </ul>
      </div>
    </section>

    <section class="content-pricing<% if (_useLegacyFunnelClasses) { %> funnel-pricing<% } %> prose">
      <div class="container">
        <h2>Cena a platba</h2>
        <p>
          <strong>Plná cena:</strong> minimálne <%= _minSessionEur %> €, <strong>odporúčaná suma <%= _fullCheckoutEur %> €</strong>. Ak ešte nie si istý/á, môžeš zaplatiť len <strong><%= _depositEur %> € za rezerváciu</strong> a o doplatku sa rozhodnúť neskôr.
        </p>
      </div>
    </section>

    <%- include('content-faq', { useLegacyFunnelClasses: _useLegacyFunnelClasses }) %>

    <section class="content-cta-repeat<% if (_useLegacyFunnelClasses) { %> funnel-cta-repeat<% } %> prose">
      <div class="container">
        <p><a href="#booking" class="cta">Vyber si termín</a></p>
      </div>
    </section>
  </div>
</details>
<% } %>
