<main>
  <!-- Campaign block: varies per ad/campaign -->
  <section class="funnel-hero">
    <div class="container">
      <h1><%= campaign.headline || 'Nadpis pilot funnels' %></h1>
      <p class="muted"><%= campaign.subhead || 'Podnadpis – stručný popis ponuky.' %></p>
    </div>
  </section>

  <section class="funnel-video">
    <div class="container">
      <% if (campaign.videoUrl) { %>
        <div class="funnel-video-embed">
          <iframe src="<%= campaign.videoUrl %>" title="Video" allowfullscreen></iframe>
        </div>
      <% } else { %>
        <p>[Video tu – bude embed]</p>
      <% } %>
    </div>
  </section>

  <section class="funnel-video-summary prose">
    <div class="container">
      <h2>Krátke zhrnutie</h2>
      <%- campaign.summary || '<p>Placeholder text pre zhrnutie…</p>' %>
    </div>
  </section>

  <%- include('_funnel-content') %>
</main>
