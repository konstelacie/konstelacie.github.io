<main>
  <section class="funnel-hero">
    <div class="container">
      <h1 id="success-main-title">Potvrdzujeme platbu</h1>

      <div id="success-loading" class="success-state">
        <p class="muted">Potvrdzujeme tvoju platbu. Chvíľu to môže trvať…</p>
      </div>

      <div id="success-confirmed" class="success-state" hidden>
        <div
          id="success-email-delivery-alert"
          class="success-delivery-alert"
          role="alert"
          aria-live="polite"
          hidden
        >
          <div class="success-delivery-alert__icon" aria-hidden="true">⚠</div>
          <div class="success-delivery-alert__content">
            <h2 class="success-delivery-alert__title">Nepodarilo sa doručiť potvrdenie</h2>
            <p id="success-email-delivery-alert-text" class="success-delivery-alert__text"></p>
            <div class="success-delivery-alert__actions">
              <button type="button" id="success-fix-email-toggle" class="cta" aria-expanded="false" aria-controls="success-fix-email-panel">Opraviť e-mail</button>
              <button type="button" id="success-support-cta" class="cta-secondary">Napísať na podporu</button>
            </div>
            <div id="success-fix-email-panel" class="success-delivery-alert__fix-panel" hidden>
              <form id="success-fix-email-form" class="booking-email-form success-fix-email-form" novalidate>
                <label for="success-fix-email-input">Správna e-mailová adresa</label>
                <input
                  type="email"
                  id="success-fix-email-input"
                  name="email"
                  autocomplete="email"
                  inputmode="email"
                  required
                  maxlength="255"
                  placeholder="tvoj@email.sk"
                />
                <button type="submit" id="success-fix-email-submit" class="cta">Odoslať potvrdenie znova</button>
                <p id="success-fix-email-error" class="booking-error" role="alert" hidden></p>
                <p id="success-fix-email-success" class="success-fix-email-success" role="status" hidden></p>
              </form>
            </div>
            <div id="success-meeting-link-block" class="success-delivery-alert__meeting" hidden>
              <p class="success-delivery-alert__meeting-label">
                Odkaz na stretnutie (môžeš si ho uložiť aj bez e-mailu):
              </p>
              <div class="success-meeting-url-row">
                <span id="success-meeting-url" class="success-meeting-url"></span>
                <button type="button" id="success-meeting-copy" class="cta-secondary">Kopírovať</button>
              </div>
              <p id="success-meeting-copy-msg" class="success-meeting-copy-msg muted" role="status" hidden>Skopírované.</p>
            </div>
            <p class="success-delivery-alert__contact">
              Alebo nám napíšte priamo na
              <a id="success-support-mailto" href="mailto:<%= supportEmail %>"><%= supportEmail %></a>
            </p>
          </div>
        </div>

        <div class="success-section success-section--summary">
          <div id="success-variant-deposit" class="success-variant" hidden>
            <p class="success-lead">Tvoj termín je rezervovaný.</p>
            <p class="success-details">
              <span id="success-slot-deposit" class="success-detail"></span>
              <span id="success-amount-deposit" class="success-detail success-detail-amount"></span>
            </p>
          </div>
          <div id="success-variant-full" class="success-variant" hidden>
            <p class="success-lead">Teším sa na naše stretnutie.</p>
            <p class="success-details">
              <span id="success-slot-full" class="success-detail"></span>
              <span id="success-amount-full" class="success-detail success-detail-amount"></span>
            </p>
          </div>
        </div>

        <div class="success-section">
          <h2 class="success-section-title">Čo bude nasledovať</h2>
          <ul class="success-next-steps">
            <li id="success-email-confirmation-default" class="success-next-step muted">Potvrdenie sme Ti poslali e-mailom.</li>
            <li id="success-email-notice" class="success-next-step muted" hidden></li>
            <li class="success-next-step muted">
              Približne 20 minút pred sedením Ti pošleme ešte pripomienku s odkazom na pripojenie.
            </li>
            <li id="success-footer-deposit" class="success-next-step muted" hidden>
              Po sedení sa môžeš v pokoji rozhodnúť, ako to budeš chcieť uzavrieť.
            </li>
            <li id="success-footer-full" class="success-next-step muted" hidden>
              Na sedenie sa nemusíš nijako špeciálne pripravovať.
            </li>
          </ul>
        </div>

        <div class="success-section success-section--calendar">
          <h2 class="success-section-title">Ulož si termín do kalendára</h2>
          <div class="success-calendar-actions">
            <a
              id="success-calendar-google"
              class="success-calendar-card"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
            >
              📅 Google Kalendár
            </a>
            <button type="button" id="success-calendar-ics" class="success-calendar-card">
              📥 Apple / Outlook (.ics)
            </button>
          </div>
        </div>
      </div>

      <div id="success-processing" class="success-state" hidden>
        <p class="muted">Potvrdenie ešte pripravujeme. Chvíľu to môže trvať.</p>
      </div>

      <div id="success-error" class="success-state" hidden>
        <p class="muted">Nepodarilo sa načítať potvrdenie platby.</p>
        <p id="success-error-message" class="muted"></p>
        <p id="success-error-support" class="success-error-support" hidden>
          <button type="button" id="success-error-support-cta" class="cta-secondary">Kontaktovať podporu</button>
        </p>
      </div>
    </div>
  </section>

  <section id="success-cta-section" class="content-cta success-cta prose" hidden>
    <div class="container">
      <div class="success-section success-section--prep">
        <h2 class="success-section-title">Príprava na sedenie</h2>
        <div class="success-cta-actions">
          <a href="/ako-sa-pripravit-na-sedenie" class="cta-secondary">Ako sa pripraviť na sedenie</a>
          <p class="success-cta-reassurance">
            Nemusíš sa pripravovať dokonale. Stačí prísť taký/á, aký/á práve si.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<div
  id="support-contact-modal"
  class="booking-modal support-contact-modal"
  hidden
  data-support-email="<%= supportEmail %>"
>
  <div class="booking-modal__backdrop" data-support-modal-dismiss role="presentation"></div>
  <div
    class="booking-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="support-contact-modal-title"
  >
    <button type="button" id="support-contact-modal-close" class="booking-modal__close" aria-label="Zavrieť">×</button>

    <div id="support-contact-form-view">
      <h2 id="support-contact-modal-title" class="booking-modal__title">Napísať na podporu</h2>
      <p class="booking-modal__phase">Popíš nám problém a ozveme sa ti.</p>
      <form id="support-contact-form" class="booking-email-form booking-modal__form" novalidate>
        <label for="support-contact-message">Správa</label>
        <textarea
          id="support-contact-message"
          name="message"
          rows="5"
          required
          maxlength="2000"
          placeholder="Popíšte váš problém…"
        ></textarea>

        <label for="support-contact-phone">Telefón <span class="support-contact-optional">(nepovinné)</span></label>
        <input
          type="tel"
          id="support-contact-phone"
          name="phone"
          autocomplete="tel"
          inputmode="tel"
          maxlength="30"
        />

        <div class="support-contact-modal__actions">
          <button type="submit" id="support-contact-submit" class="cta">Odoslať</button>
          <button type="button" class="cta-secondary" data-support-modal-dismiss>Zrušiť</button>
        </div>

        <p id="support-contact-error" class="booking-error" role="alert" aria-live="polite" hidden></p>
        <p id="support-contact-mailto-fallback" class="support-contact-mailto-fallback muted" hidden>
          Ak sa odoslanie nepodarí, napíš nám priamo na
          <a id="support-contact-mailto-link" href="mailto:<%= supportEmail %>"><%= supportEmail %></a>.
        </p>
      </form>
      <p class="support-contact-modal__footer muted">
        Alebo nám napíšte priamo na
        <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>
      </p>
    </div>

    <div id="support-contact-success-view" hidden>
      <h2 class="booking-modal__title">Správa odoslaná</h2>
      <p id="support-contact-success-text" class="booking-modal__phase" role="status" aria-live="polite">
        Ďakujeme, správu sme prijali. Ozveme sa ti čo najskôr.
      </p>
      <button type="button" class="cta" data-support-modal-dismiss>Zavrieť</button>
    </div>
  </div>
</div>
