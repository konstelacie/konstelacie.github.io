PORT=3000
NODE_ENV=development

# MySQL (alwaysdata: mysql-{account}.alwaysdata.net)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=citim_teda_som

# Stripe (see docs/STRIPE-ARCHITECTURE.md)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Base URL for Stripe redirects (success/cancel). Default: derived from request.
# BASE_URL=https://your-app.alwaysdata.net

# Resend (transactional emails; see docs/EMAILING.md)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=citimtedasom.sk

# Cron (scheduled jobs; see docs/SCHEDULED-EMAILS-CRON.md)
# Required in production. On localhost in development, endpoint works without it for testing.
CRON_SECRET=
