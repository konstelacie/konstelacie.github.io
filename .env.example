PORT=3000
NODE_ENV=development

# MySQL (alwaysdata: mysql-{account}.alwaysdata.net)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=citim_teda_som

# --- Page visibility (see docs/PAGE-VISIBILITY.md) ---
# Defaults when unset: SITE_HOME_MODE=test, FUNNEL_{NAME}_MODE=hidden (invalid value → same default).
# Home: test = noindex; prod = indexable on /
SITE_HOME_MODE=test
# Funnel pages: hidden | test (-test URL suffix) | prod
FUNNEL_PILOT_MODE=hidden
FUNNEL_MANIPULACIA_MODE=test

# --- Booking amounts (see docs/SESSION-PRICING.md, src/lib/bookingCheckoutAmounts.js) ---
# Minimum session total; also reservation deposit on home (site).
BOOKING_SESSION_MIN_EUR=45
# “Pay in full now” at checkout (all surfaces).
BOOKING_SESSION_FULL_EUR=85
# Per-funnel reservation deposit. Omit → falls back to BOOKING_SESSION_MIN_EUR.
FUNNEL_PILOT_DEPOSIT_EUR=10
FUNNEL_MANIPULACIA_DEPOSIT_EUR=10

# --- Stripe: configure BOTH backends; runtime picks by booking surface ---
# No in-code defaults — set keys for each backend you use. Unset secret → 503 on checkout for that surface.
STRIPE_PUBLIC_KEY_TEST=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

STRIPE_PUBLIC_KEY_PROD=
STRIPE_SECRET_KEY_PROD=
STRIPE_WEBHOOK_SECRET_PROD=

# Signed links for optional session balance / doplatok (GET /platba-doplatok, /api/payments/balance/*). Required in production.
# BALANCE_PAY_TOKEN_SECRET=

# Optional. Standard VAT rate as decimal (e.g. 0.23). Used for billing_documents net/VAT split until accountant confirms.
BILLING_VAT_RATE=0.23
BILLING_SERVICE_NAME=Online sprevádzanie
BILLING_IBAN=
BILLING_SWIFT=

# Billing PDF + invoice email (Phase 2). PDFs stored under storage/billing-pdfs/ unless BILLING_PDF_STORAGE_DIR is set.
# BILLING_DOCUMENT_PREFIX=CT
# BILLING_PDF_STORAGE_DIR=
# KROS migration (Phase 0): secrets prepared while billing_documents PDF flow remains primary.
KROS_API_TOKEN=
KROS_WEBHOOK_SECRET=   # 50-char key from KROS
KROS_ENABLED=true   # set to true when ready to test live
# KROS has no sandbox — prefix distinguishes test vs prod invoice sequences (e.g. T-OF vs OF).
# KROS_SEQUENCE_PREFIX_PROD: omit or leave empty → prod sequence OF (no prefix).
KROS_SEQUENCE_PREFIX_TEST=T
KROS_SEQUENCE_PREFIX_PROD=
# Set to 1 to enable verbose debug logging (KROS payloads, raw webhook bodies, etc.)
DEBUG_LOGS=
# Set to 0/false to generate PDF only, skip invoice email (e.g. debugging).
# BILLING_SEND_INVOICE_EMAIL=true
# Customer email when KROS webhook is delayed (Phase 4). Default: enabled.
# BILLING_DELAYED_EMAIL_ENABLED=true
# Minutes before billing-deliver-stuck treats accepted KROS docs as stuck (default 30).
# KROS_STUCK_THRESHOLD_MINUTES=30
# Supplier block on PDF (confirm with accountant).
BILLING_INVOICE_COMPANY_NAME=
BILLING_INVOICE_COMPANY_ADDRESS=Line one\nLine two
BILLING_INVOICE_ICO=
BILLING_INVOICE_DIC=
BILLING_INVOICE_IC_DPH=

# Base URL for Stripe redirects (success/cancel). Default: derived from request.
# BASE_URL=https://your-app.alwaysdata.net

# Resend (transactional emails; see docs/EMAILING.md)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=citimtedasom.sk
# Google Meet link included in reservation confirmation and pre-session reminder emails.
SESSION_MEETING_URL=

# Cron (scheduled jobs; see docs/SCHEDULED-EMAILS-CRON.md)
# Required in production for /api/cron/run (runs all jobs: pre-session reminder, billing deliver-stuck fallback).
# On localhost in development, /api/cron/run works without it for testing.
CRON_SECRET=

# Admin UI (see docs/ui-ux/admin-interface.md)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Required in production — signs the admin session cookie. In development, a dev fallback is used if unset.
SESSION_SECRET=

# Meta / Facebook Pixel (optional). Loaded only after "Súhlasím s marketingom" in the cookie banner.
# META_PIXEL_ID=

# Legal pages: imprint + contact (recommended in production). Falls back to RESEND_FROM_EMAIL if SITE_LEGAL_EMAIL unset.
# SITE_LEGAL_ENTITY=Prevádzkovateľ: …, sídlo …, IČO …
# SITE_LEGAL_EMAIL=kontakt@example.com

# Test-mode warning banner on home/funnel surfaces when their mode is test.
# Default when unset: banner shown on test surfaces. Set to 0 / false to hide globally.
# SITE_TESTING_BANNER=0
